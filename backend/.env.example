# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/campus-companion

# Express Server Port
PORT=5000

# JWT Secrets (use secure random strings in production)
JWT_SECRET=super_secret_jwt_sign_key_for_campus_companion_development_12345
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Get from Google AI Studio)
# If left blank, backend will fall back to heuristic rule-based NLP insights and roadmaps.
AI_API_KEY=

# CORS Settings
CLIENT_URL=http://localhost:5173
